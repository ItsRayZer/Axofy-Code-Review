# Axofy Code Review — copy to .env (never commit .env). All LLM providers below have
# free tiers. Pick ONE key; the app never charges anything.
# Primary (recommended): NVIDIA NIM free endpoint
NVIDIA_API_KEY=
# Fallbacks — set LLM_PROVIDER to groq | openrouter | gemini and add its key:
LLM_PROVIDER=nvidia
# LLM_MODEL=      # override the provider default model
# LLM_BASE_URL=   # override the provider API base URL
# LLM_API_KEY=    # generic override (wins over provider-specific keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# GitHub (optional — public repos work without any token)
GITHUB_TOKEN=
# GitHub App (optional — enables posting reviews/comments/check runs to PRs)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Server
PORT=3000
# AXOREVIEW_URL=http://localhost:3000   # used by the CLI (bin/axoreview.js)
# AXOREVIEW_LLM=mock                    # force mock mode (deterministic checks only, no LLM)
